@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Form dùng chung cho Thêm/Sửa *@
@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.ThanhToanHocPhi
<div class="row g-3">
        <div class="col-md-6">
            <label asp-for="MaDangKy" class="form-label"></label>
            <select asp-for="MaDangKy" asp-items="ViewBag.DangKyList" class="form-select"><option value="">-- Chọn đăng ký --</option></select>
            <span asp-validation-for="MaDangKy" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SoTien" class="form-label"></label>
            <input asp-for="SoTien" class="form-control" type="number" min="1" step="any" />
            <span asp-validation-for="SoTien" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PhuongThuc" class="form-label"></label>
            <select asp-for="PhuongThuc" class="form-select"><option value="">-- Chọn --</option><option>Tiền mặt</option><option>Chuyển khoản</option><option>Thẻ</option></select>
            <span asp-validation-for="PhuongThuc" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
            <span asp-validation-for="GhiChu" class="text-danger"></span>
        </div>
</div>
