            <label asp-for="SoNamKinhNghiemMon" class="form-label"></label>
            <input asp-for="SoNamKinhNghiemMon" class="form-control" min="0" />
            <span asp-validation-for="SoNamKinhNghiemMon" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
            <span asp-validation-for="GhiChu" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="TrangThai" class="form-label"></label>
            <select asp-for="TrangThai" class="form-select"><option value="">-- Chọn --</option><option>Hoạt động</option><option>Khóa</option></select>
            <span asp-validation-for="TrangThai" class="text-danger"></span>
        </div>
</div>
