@* Form dùng chung cho thêm và sửa chuyên môn gia sư. *@
@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.ChuyenMonGiaSu
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MaGiaSu" class="form-label">Gia sư</label>
        <select asp-for="MaGiaSu" asp-items="ViewBag.GiaSuList" class="form-select"><option value="">-- Chọn gia sư --</option></select>
        <span asp-validation-for="MaGiaSu" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MaMonHoc" class="form-label">Môn học</label>
        <select asp-for="MaMonHoc" asp-items="ViewBag.MonHocList" class="form-select"><option value="">-- Chọn môn học --</option></select>
        <span asp-validation-for="MaMonHoc" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select"><option>Hoạt động</option><option>Khóa</option></select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
</div>
