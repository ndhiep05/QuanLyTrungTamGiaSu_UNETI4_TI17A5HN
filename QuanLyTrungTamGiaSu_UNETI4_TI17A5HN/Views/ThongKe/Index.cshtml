@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@model ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Thống kê</h1>
        <p class="page-sub">Số liệu tổng hợp từ cơ sở dữ liệu</p>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="stat-icon stat-amber"><i class="bi bi-trophy"></i></div>
            <div>
                <div class="stat-label">Môn học có nhiều lượt đăng ký nhất</div>
                <div class="fw-bold fs-5">@(Model.MonHocNhieuDangKyNhat?.Ten ?? "Chưa có dữ liệu")</div>
                @if (Model.MonHocNhieuDangKyNhat != null) { <small class="text-muted">@Model.MonHocNhieuDangKyNhat.SoLuong lượt đăng ký</small> }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="stat-icon stat-indigo"><i class="bi bi-person-check"></i></div>
            <div>
                <div class="stat-label">Gia sư đang phụ trách nhiều lớp nhất</div>
                <div class="fw-bold fs-5">@(Model.GiaSuNhieuLopNhat?.Ten ?? "Chưa có dữ liệu")</div>
                @if (Model.GiaSuNhieuLopNhat != null) { <small class="text-muted">@Model.GiaSuNhieuLopNhat.SoLuong lớp</small> }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-journal-bookmark me-2"></i>Số lớp theo môn học</div>
            <div class="card-body">
                @if (Model.LopTheoMonHoc.Count == 0) { <p class="text-muted mb-0">Chưa có dữ liệu.</p> }
                @{ var maxLopTheoMonHoc = Model.LopTheoMonHoc.Count == 0 ? 1 : Math.Max(1, Model.LopTheoMonHoc.Max(x => x.SoLuong)); }
                @foreach (var x in Model.LopTheoMonHoc)
                {
                    <div class="bar-row">
                        <div class="bar-label" title="@x.Ten">@x.Ten</div>
                        <div class="bar-track"><div class="bar-fill" style="width:@(x.SoLuong * 100 / maxLopTheoMonHoc)%"></div></div>
                        <div class="bar-num">@x.SoLuong</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-clipboard-data me-2"></i>Số đăng ký theo trạng thái</div>
            <div class="card-body">
                @if (Model.DangKyTheoTrangThai.Count == 0) { <p class="text-muted mb-0">Chưa có dữ liệu.</p> }
                @{ var maxDangKyTheoTrangThai = Model.DangKyTheoTrangThai.Count == 0 ? 1 : Math.Max(1, Model.DangKyTheoTrangThai.Max(x => x.SoLuong)); }
                @foreach (var x in Model.DangKyTheoTrangThai)
                {
                    <div class="bar-row">
                        <div class="bar-label" title="@x.Ten">@x.Ten</div>
                        <div class="bar-track"><div class="bar-fill" style="width:@(x.SoLuong * 100 / maxDangKyTheoTrangThai)%"></div></div>
                        <div class="bar-num">@x.SoLuong</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-people me-2"></i>Số học viên theo từng lớp</div>
            <div class="card-body">
                @if (Model.HocVienTheoLop.Count == 0) { <p class="text-muted mb-0">Chưa có dữ liệu.</p> }
                @{ var maxHocVienTheoLop = Model.HocVienTheoLop.Count == 0 ? 1 : Math.Max(1, Model.HocVienTheoLop.Max(x => x.SoLuong)); }
                @foreach (var x in Model.HocVienTheoLop)
                {
                    <div class="bar-row">
                        <div class="bar-label" title="@x.Ten">@x.Ten</div>
                        <div class="bar-track"><div class="bar-fill" style="width:@(x.SoLuong * 100 / maxHocVienTheoLop)%"></div></div>
                        <div class="bar-num">@x.SoLuong</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
