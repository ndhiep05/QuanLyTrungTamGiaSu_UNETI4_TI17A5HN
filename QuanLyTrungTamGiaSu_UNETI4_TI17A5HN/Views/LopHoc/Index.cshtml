@* Họ và tên: Nguyễn Trọng Chuyển | Mã sinh viên: 23103100204 | Nội dung thực hiện: Module 3 - Giao diện Quản lý Lớp học *@
@model IEnumerable<QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.LopHoc>

@{
    ViewData["Title"] = "Quản lý Lớp học";
    var vaiTro = Context.Session.GetString("VaiTro");
    var laAdmin = string.IsNullOrEmpty(vaiTro) || vaiTro == "Admin"; // Mặc định hiển thị quyền Admin nếu chưa set Session
    var pt = ViewBag.PhanTrang as QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.ViewModels.PhanTrangViewModel;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="fw-bold text-primary mb-0">Lớp học</h2>
            <p class="text-muted mb-0">Danh sách các lớp học trong hệ thống</p>
        </div>
        @if (laAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Thêm mới lớp học
            </a>
        }
    </div>

    <!-- Thanh tìm kiếm & lọc -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm theo tên lớp hoặc mô tả..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="maMonHoc" asp-items="@ViewBag.MaMonHoc" class="form-select">
                        <option value="">-- Tất cả môn học --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách lớp học -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-3x mb-3 text-secondary"></i>
                    <p class="mb-0">Không có dữ liệu lớp học phù hợp.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7">
                            <tr>
                                <th class="ps-3">Tên lớp</th>
                                <th>Môn học</th>
                                <th>Trình độ</th>
                                <th>Thời gian</th>
                                <th>Sĩ số tối đa</th>
                                <th>Học phí</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@(item.TenLop)</td>
                                    <td>@(item.MonHoc?.TenMonHoc ?? "N/A")</td>
                                    <td>@(item.TrinhDoLop ?? "Căn bản")</td>
                                    <td>
                                        <small class="text-muted">
                                            @(item.NgayBatDau.ToString("dd/MM/yyyy")) – @(item.NgayKetThuc.ToString("dd/MM/yyyy"))
                                        </small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.SiSoToiDa học viên</span></td>
                                    <td class="fw-bold text-success">@(item.HocPhi.ToString("N0")) ₫</td>
                                    <td>
                                        @if (item.TrangThai == "Đang mở đăng ký" || item.TrangThai == "Mở")
                                        {
                                            <span class="badge bg-success">Đang mở</span>
                                        }
                                        else if (item.TrangThai == "Đã đủ")
                                        {
                                            <span class="badge bg-danger">Đã đủ chỗ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MaLop" class="btn btn-outline-info" title="Chi tiết"><i class="fas fa-eye"></i></a>

                                            @if (vaiTro == "HocVien" && item.TrangThai == "Đang mở đăng ký")
                                            {
                                                <form asp-controller="DangKyLop" asp-action="DangKy" method="post" class="d-inline">
                                                    <input type="hidden" name="maLop" value="@item.MaLop" />
                                                    <button type="submit" class="btn btn-sm btn-success ms-1">Đăng ký</button>
                                                </form>
                                            }

                                            @if (laAdmin)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.MaLop" class="btn btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                                
                                                <form asp-action="Delete" asp-route-id="@item.MaLop" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Thanh Phân Trang Nhúng Trực Tiếp -->
        @if (pt != null && pt.TotalPages > 1)
        {
            var tong = pt.TotalPages;
            var tu = Math.Max(1, pt.Page - 2);
            var den = Math.Min(tong, pt.Page + 2);

            string Link(int p)
            {
                var parts = Context.Request.Query
                    .Where(q => !string.Equals(q.Key, "trang", StringComparison.OrdinalIgnoreCase))
                    .Select(q => Uri.EscapeDataString(q.Key) + "=" + Uri.EscapeDataString(q.Value.ToString()))
                    .ToList();
                parts.Add("trang=" + p);
                return Context.Request.PathBase + Context.Request.Path + "?" + string.Join("&", parts);
            }

            <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center py-3">
                <small class="text-muted">Hiển thị @pt.TuMuc - @pt.DenMuc / @pt.TotalItems lớp học</small>
                <nav aria-label="Phân trang">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(pt.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Link(pt.Page - 1)">&laquo;</a>
                        </li>
                        @if (tu > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@Link(1)">1</a></li>
                            if (tu > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                        }
                        @for (var trang = tu; trang <= den; trang++)
                        {
                            <li class="page-item @(trang == pt.Page ? "active" : "")">
                                <a class="page-link" href="@Link(trang)">@trang</a>
                            </li>
                        }
                        @if (den < tong)
                        {
                            if (den < tong - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                            <li class="page-item"><a class="page-link" href="@Link(tong)">@tong</a></li>
                        }
                        <li class="page-item @(pt.Page >= tong ? "disabled" : "")">
                            <a class="page-link" href="@Link(pt.Page + 1)">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>