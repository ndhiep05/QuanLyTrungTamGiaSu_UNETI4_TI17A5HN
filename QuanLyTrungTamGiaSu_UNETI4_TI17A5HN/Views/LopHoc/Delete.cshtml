@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.LopHoc
@{
    ViewData["Title"] = "Xóa lớp học";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Xóa lớp học</h1>
        <p class="page-sub">Thao tác này không thể hoàn tác</p>
    </div>
</div>
<div class="card form-card">
    <div class="card-body">
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa lớp học này không?</div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Tên lớp</dt>
            <dd class="col-sm-9">@(Model.TenLop)</dd>
            <dt class="col-sm-3">Môn học</dt>
            <dd class="col-sm-9">@(Model.MonHoc?.TenMonHoc)</dd>
            <dt class="col-sm-3">Trình độ</dt>
            <dd class="col-sm-9">@(Model.TrinhDoLop)</dd>
            <dt class="col-sm-3">Thời gian</dt>
            <dd class="col-sm-9">@(Model.NgayBatDau.ToString("dd/MM/yyyy") + " – " + Model.NgayKetThuc.ToString("dd/MM/yyyy"))</dd>
            <dt class="col-sm-3">Sĩ số tối đa</dt>
            <dd class="col-sm-9">@(Model.SiSoToiDa)</dd>
            <dt class="col-sm-3">Học phí</dt>
            <dd class="col-sm-9">@(Model.HocPhi.ToString("N0")) ₫</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9"><partial name="_TrangThaiBadge" model="Model.TrangThai" /></dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="MaLop" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-light">Hủy</a>
            </div>
        </form>
    </div>
</div>
