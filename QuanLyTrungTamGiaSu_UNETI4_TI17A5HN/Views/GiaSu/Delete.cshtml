@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@* Nguyễn Đức Hùng | 23103100212 | Cảnh báo và chặn thao tác xóa gia sư đã được phân công (SV2) *@
@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.GiaSu
@{
    ViewData["Title"] = "Xóa gia sư";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Xóa gia sư</h1>
        <p class="page-sub">Thao tác này không thể hoàn tác</p>
    </div>
</div>
<div class="card form-card">
    <div class="card-body">
        @if (ViewBag.CoLichSuPhanCong == true || ViewBag.CoLichHoc == true)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Gia sư đã có lịch sử phân công hoặc lịch học nên không thể xóa. Bạn có thể chuyển trạng thái sang Khóa.
            </div>
        }
        else
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa gia sư này không?</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@(Model.HoTen)</dd>
            <dt class="col-sm-3">Điện thoại</dt>
            <dd class="col-sm-9">@(Model.SoDienThoai)</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email)</dd>
            <dt class="col-sm-3">Trình độ</dt>
            <dd class="col-sm-9">@(Model.TrinhDo)</dd>
            <dt class="col-sm-3">Kinh nghiệm</dt>
            <dd class="col-sm-9">@(Model.KinhNghiem + " năm")</dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9"><partial name="_TrangThaiBadge" model="Model.TrangThai" /></dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.MaGiaSu" />
            <div class="form-actions">
                @if (ViewBag.CoLichSuPhanCong != true && ViewBag.CoLichHoc != true)
                {
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Xác nhận xóa</button>
                }
                <a asp-action="Index" class="btn btn-light">Hủy</a>
            </div>
        </form>
    </div>
</div>
