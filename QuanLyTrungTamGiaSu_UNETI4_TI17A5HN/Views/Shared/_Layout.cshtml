@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@{
    var vaiTro = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen") ?? "Khách";
    var anhDaiDien = Context.Session.GetString("AnhDaiDien");
    var daDangNhap = !string.IsNullOrEmpty(vaiTro);
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // (Controller, Action, Tiêu đề, Icon). Controller rỗng = tiêu đề nhóm.
    var menu = new List<(string C, string A, string T, string I)>();
    if (vaiTro == "Admin")
    {
        menu.Add(("", "", "Tổng quan", ""));
        menu.Add(("ThongKe", "Dashboard", "Dashboard", "bi-speedometer2"));
        menu.Add(("ThongKe", "Index", "Thống kê", "bi-bar-chart-line"));
        menu.Add(("", "", "Danh mục", ""));
        menu.Add(("TaiKhoan", "Index", "Tài khoản", "bi-person-gear"));
        menu.Add(("MonHoc", "Index", "Môn học", "bi-journal-bookmark"));
        menu.Add(("GiaSu", "Index", "Gia sư", "bi-person-workspace"));
        menu.Add(("ChuyenMonGiaSu", "Index", "Chuyên môn gia sư", "bi-mortarboard"));
        menu.Add(("HocVien", "Index", "Học viên", "bi-people"));
        menu.Add(("", "", "Đào tạo", ""));
        menu.Add(("LopHoc", "Index", "Lớp học", "bi-easel"));
        menu.Add(("DangKyLop", "Index", "Đăng ký lớp", "bi-clipboard-check"));
        menu.Add(("PhanCongGiaSu", "Index", "Phân công gia sư", "bi-diagram-3"));
        menu.Add(("LichHoc", "Index", "Lịch học", "bi-calendar-week"));
        menu.Add(("DiemDanh", "Index", "Điểm danh", "bi-check2-square"));
        menu.Add(("", "", "Tài chính", ""));
        menu.Add(("ThanhToanHocPhi", "Index", "Thanh toán học phí", "bi-cash-coin"));
        menu.Add(("", "", "Cá nhân", ""));
        menu.Add(("TaiKhoan", "HoSo", "Hồ sơ cá nhân", "bi-person-vcard"));
    }
    else if (vaiTro == "GiaSu")
    {
        menu.Add(("", "", "Giảng dạy", ""));
        menu.Add(("PhanCongGiaSu", "Index", "Lớp được phân công", "bi-diagram-3"));
        menu.Add(("LichHoc", "Index", "Lịch dạy", "bi-calendar-week"));
        menu.Add(("DiemDanh", "Index", "Điểm danh", "bi-check2-square"));
        menu.Add(("", "", "Cá nhân", ""));
        menu.Add(("ChuyenMonGiaSu", "Index", "Chuyên môn của tôi", "bi-mortarboard"));
        menu.Add(("TaiKhoan", "HoSo", "Hồ sơ cá nhân", "bi-person-vcard"));
    }
    else if (vaiTro == "HocVien")
    {
        menu.Add(("", "", "Học tập", ""));
        menu.Add(("LopHoc", "Index", "Lớp học", "bi-easel"));
        menu.Add(("DangKyLop", "Index", "Đăng ký của tôi", "bi-clipboard-check"));
        menu.Add(("LichHoc", "Index", "Lịch học", "bi-calendar-week"));
        menu.Add(("DiemDanh", "Index", "Điểm danh của tôi", "bi-check2-square"));
        menu.Add(("ThanhToanHocPhi", "Index", "Học phí", "bi-cash-coin"));
        menu.Add(("", "", "Cá nhân", ""));
        menu.Add(("TaiKhoan", "HoSo", "Hồ sơ cá nhân", "bi-person-vcard"));
    }
    else
    {
        menu.Add(("Home", "Index", "Trang chủ", "bi-house"));
        menu.Add(("TaiKhoan", "DangNhap", "Đăng nhập", "bi-box-arrow-in-right"));
    }

    string vaiTroText = vaiTro switch { "Admin" => "Quản trị viên", "GiaSu" => "Gia sư", "HocVien" => "Học viên", _ => "Khách" };
    string chuCai = string.IsNullOrWhiteSpace(hoTen) ? "?" : hoTen.Trim().Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trung tâm gia sư</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <span class="logo"><i class="bi bi-mortarboard-fill"></i></span>
            <span>Trung tâm<br />Gia sư</span>
        </a>
        <nav class="sidebar-nav">
            @foreach (var m in menu)
            {
                if (m.C == "")
                {
                    <div class="menu-heading">@m.T</div>
                }
                else
                {
                    var cungController = menu.Count(x => x.C == m.C) > 1;
                    var active = ctrl == m.C && (!cungController || act == m.A);
                    <a class="menu-link @(active ? "active" : "")" asp-controller="@m.C" asp-action="@m.A">
                        <i class="bi @m.I"></i><span>@m.T</span>
                    </a>
                }
            }
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <button type="button" class="btn btn-light sidebar-toggle" id="btnSidebar" aria-label="Mở menu"><i class="bi bi-list"></i></button>
            <div class="page-crumb">@ViewData["Title"]</div>
            <div class="ms-auto dropdown">
                <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (!string.IsNullOrEmpty(anhDaiDien))
                    {
                        <img src="@anhDaiDien" class="avatar" style="object-fit: cover;" alt="Avatar" />
                    }
                    else
                    {
                        <span class="avatar">@chuCai</span>
                    }
                    <span class="text-start d-none d-sm-block">
                        <span class="d-block fw-semibold lh-1">@hoTen</span>
                        <small class="text-muted">@vaiTroText</small>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    @if (daDangNhap)
                    {
                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="HoSo"><i class="bi bi-person-circle me-2"></i>Hồ sơ cá nhân</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    }
                    else
                    {
                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DangNhap"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </header>

        <main class="content">
            @if (TempData["ThanhCong"] is string tc)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-1"></i> @tc
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Loi"] is string loi)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i> @loi
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="footer">&copy; @DateTime.Now.Year - Hệ thống quản lý trung tâm gia sư và đăng ký lớp học</footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.getElementById('btnSidebar')?.addEventListener('click', function () {
        document.getElementById('sidebar').classList.toggle('open');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
