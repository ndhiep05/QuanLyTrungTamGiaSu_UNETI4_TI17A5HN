@* Họ và tên: <Nguyễn Đình Hiệp> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@model IEnumerable<QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.TaiKhoan>
@{
    ViewData["Title"] = "Tài khoản";
    var vaiTro = Context.Session.GetString("VaiTro");
    var laAdmin = vaiTro == "Admin";
    string? tuKhoa = ViewBag.TuKhoa as string;
    string? filterVaiTro = ViewBag.VaiTro as string;
    string? trangThai = ViewBag.TrangThai as string;
    string? sapXep = ViewBag.SapXep as string;
    var pt = ViewBag.PhanTrang as PhanTrangViewModel;

    var dsVaiTro = new[] { ("Admin", "Quản trị viên"), ("GiaSu", "Gia sư"), ("HocVien", "Học viên") };
    var dsTrangThai = new[] { ("HoatDong", "Hoạt động"), ("Khoa", "Khóa") };
    var dsSapXep = new[] { 
        ("id_giam", "Mới nhất"),
        ("id_tang", "Cũ nhất"),
        ("ten_tang", "Tên đăng nhập A → Z"),
        ("ten_giam", "Tên đăng nhập Z → A"),
        ("hoten_tang", "Họ tên A → Z"),
        ("hoten_giam", "Họ tên Z → A")
    };
}
<div class="page-header">
    <div>
        <h1 class="page-title">Tài khoản</h1>
        <p class="page-sub">Tìm kiếm, lọc, sắp xếp và phân trang danh sách tài khoản</p>
    </div>
    @if (laAdmin)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm mới</a>
    }
</div>

<div class="card card-table">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4 col-xl-4">
                <label class="form-label small mb-1">Từ khóa</label>
                <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Tên đăng nhập, họ tên, email..." />
            </div>
            <div class="col-md-4 col-xl-2">
                <label class="form-label small mb-1">Vai trò</label>
                <select name="vaiTro" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var (v, t) in dsVaiTro) { <option value="@v" selected="@(filterVaiTro == v)">@t</option> }
                </select>
            </div>
            <div class="col-md-4 col-xl-2">
                <label class="form-label small mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var (v, t) in dsTrangThai) { 
                        var isSel = string.Equals(trangThai, v, StringComparison.OrdinalIgnoreCase) || 
                                    (v == "HoatDong" && trangThai == "Hoạt động") ||
                                    (v == "Khoa" && trangThai == "Khóa");
                        <option value="@v" selected="@isSel">@t</option> 
                    }
                </select>
            </div>
            <div class="col-md-4 col-xl-2">
                <label class="form-label small mb-1">Sắp xếp</label>
                <select name="sapXep" class="form-select">
                    @foreach (var (v, t) in dsSapXep) { <option value="@v" selected="@(sapXep == v)">@t</option> }
                </select>
            </div>
            <div class="col-12 col-xl-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-light">Đặt lại</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-inbox"></i>Không tìm thấy tài khoản phù hợp.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var vaiTroLabel = item.VaiTro switch {
                        "Admin" => "Quản trị viên",
                        "GiaSu" => "Gia sư",
                        "HocVien" => "Học viên",
                        _ => item.VaiTro
                    };
                    var vaiTroColor = item.VaiTro switch {
                        "Admin" => "danger",
                        "GiaSu" => "primary",
                        "HocVien" => "info",
                        _ => "secondary"
                    };
                    <tr>
                        <td class="fw-semibold">@(item.TenDangNhap)</td>
                        <td>@(item.HoTen)</td>
                        <td>@(item.Email)</td>
                        <td><span class="badge badge-soft-@vaiTroColor">@vaiTroLabel</span></td>
                        <td><partial name="_TrangThaiBadge" model="item.TrangThai" /></td>
                        <td class="text-end text-nowrap">
                            @if (laAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @if (pt != null && pt.TotalItems > 0)
    {
        <div class="card-footer"><partial name="_PhanTrang" model="pt" /></div>
    }
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-info alert-dismissible fade show mt-3"
         role="alert">
        @TempData["ThongBao"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng"></button>
    </div>
}
