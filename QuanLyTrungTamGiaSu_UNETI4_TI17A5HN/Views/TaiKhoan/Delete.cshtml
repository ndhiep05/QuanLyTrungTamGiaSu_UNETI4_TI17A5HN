@* Họ và tên: <Điền họ và tên> | Mã sinh viên: 23103100230 | Nội dung thực hiện: Giao diện dùng chung (SV1) *@
@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.TaiKhoan
@{
    ViewData["Title"] = "Xóa tài khoản";
    var vaiTroLabel = Model.VaiTro switch {
        "Admin" => "Quản trị viên",
        "GiaSu" => "Gia sư",
        "HocVien" => "Học viên",
        _ => Model.VaiTro
    };
    var vaiTroColor = Model.VaiTro switch {
        "Admin" => "danger",
        "GiaSu" => "purple",
        "HocVien" => "info",
        _ => "secondary"
    };
}
<div class="page-header">
    <div>
        <h1 class="page-title">Xóa tài khoản</h1>
        <p class="page-sub">Thao tác này không thể hoàn tác</p>
    </div>
</div>
<div class="card form-card">
    <div class="card-body">
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc chắn muốn xóa tài khoản này không?</div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Tên đăng nhập</dt>
            <dd class="col-sm-9">@(Model.TenDangNhap)</dd>
            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@(Model.HoTen)</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email)</dd>
            <dt class="col-sm-3">Vai trò</dt>
            <dd class="col-sm-9"><span class="badge badge-soft-@vaiTroColor" style="@(Model.VaiTro == "GiaSu" ? "background-color: #ede9fe !important; color: #5b21b6 !important; border: 1px solid #ddd6fe !important;" : "")">@vaiTroLabel</span></dd>
            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9"><partial name="_TrangThaiBadge" model="Model.TrangThai" /></dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Xác nhận xóa</button>
                <a asp-action="Index" class="btn btn-light">Hủy</a>
            </div>
        </form>
    </div>
</div>
