@model QuanLyTrungTamGiaSu_UNETI4_TI17A5HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sửa tài khoản</h1>
        <p class="page-sub">Cập nhật thông tin và bấm Lưu thay đổi</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post">
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <input type="hidden" asp-for="MaTaiKhoan" />

            <partial name="_Form" model="Model" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-light">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}